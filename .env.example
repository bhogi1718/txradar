# Copy to .env.local and fill in. Never commit .env.local.

# Etherscan V2 (free tier: https://etherscan.io/apis). Same key works for all EVM chains.
ETHERSCAN_API_KEY=

# Optional: raises rate limits. Works without a key at reduced QPS.
# https://www.trongrid.io
TRONGRID_API_KEY=

# Optional: CoinGecko Demo key. Works without a key at reduced rate.
# https://www.coingecko.com/en/api
COINGECKO_API_KEY=
